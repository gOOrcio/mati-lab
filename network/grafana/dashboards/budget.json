    {
      "id": 7,
      "type": "timeseries",
      "title": "Monthly spending by category group",
      "description": "Categorised spending only; uncategorised rows are in the review queue. Small groups fold into Inne.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 10
