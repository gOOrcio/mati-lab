      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('month', date) AS time, CASE WHEN group_name IN ('Inne', 'Firma (JDG)') THEN 'Inne' ELSE group_name END AS metric, -SUM(amount) AS value\nFROM v_flows\nWHERE NOT is_income AND category_id IS NOT NULL AND $__timeFilter(date)\nGROUP BY 1, 2 ORDER BY 1, 2"
