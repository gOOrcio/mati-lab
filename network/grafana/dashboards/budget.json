      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT a.name AS \"Account\", last.at AS \"Last run\", last.status AS \"Status\",\n       last.new_count AS \"New\", ok.ok_at AS \"Last OK\", last.error AS \"Error\"\nFROM accounts a\nLEFT JOIN LATERAL (SELECT * FROM sync_runs s WHERE s.account_id = a.id ORDER BY at DESC LIMIT 1) last ON true\nLEFT JOIN LATERAL (SELECT max(at) AS ok_at FROM sync_runs s WHERE s.account_id = a.id AND status = 'ok') ok ON true\nWHERE a.sync_source IS NOT NULL AND NOT a.closed ORDER BY 1"
        }
      ],
