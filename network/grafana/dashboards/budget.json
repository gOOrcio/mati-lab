    {
      "id": 11,
      "type": "timeseries",
      "title": "Cash projection (what-if)",
      "description": "24 months from today's cash. Averages of the last $avg_months full months; no income for $months_no_income months, then income cut by $income_cut_pct %; plus $extra_fixed PLN/month extra fixed cost (e.g. ZUS). Set these in the variables bar.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH cash AS (SELECT COALESCE(SUM(balance), 0) AS v FROM accounts WHERE NOT offbudget AND NOT closed),\navg_m AS (\n  SELECT COALESCE(AVG(inc), 0) AS inc, COALESCE(AVG(exp), 0) AS exp FROM (\n    SELECT date_trunc('month', date) m,\n           COALESCE(SUM(amount) FILTER (WHERE is_income), 0) inc,\n           COALESCE(-SUM(amount) FILTER (WHERE NOT is_income), 0) exp\n    FROM v_flows\n    WHERE date >= date_trunc('month', now())::date - ($avg_months || ' months')::interval AND date < date_trunc('month', now())::date\n    GROUP BY 1) x),\nsim AS (\n  SELECT g AS n,\n         CASE WHEN g <= $months_no_income THEN 0 ELSE avg_m.inc * (1 - $income_cut_pct / 100.0) END\n         - (avg_m.exp + $extra_fixed) AS net\n  FROM avg_m, generate_series(1, 24) g)\nSELECT date_trunc('month', now()) + (n || ' months')::interval AS time,\n       (SELECT v FROM cash) + SUM(net) OVER (ORDER BY n) AS \"Projected cash\"\nFROM sim ORDER BY n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyPLN",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
