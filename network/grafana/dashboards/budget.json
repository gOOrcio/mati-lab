    {
      "id": 4,
      "type": "stat",
      "title": "Runway without income",
      "description": "Months the current cash lasts at the average spending of the last $avg_months full months plus $extra_fixed/month, with no income.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH cash AS (SELECT COALESCE(SUM(balance), 0) AS v FROM accounts WHERE NOT offbudget AND NOT closed),\navg_m AS (\n  SELECT COALESCE(AVG(inc), 0) AS inc, COALESCE(AVG(exp), 0) AS exp FROM (\n    SELECT date_trunc('month', date) m,\n           COALESCE(SUM(amount) FILTER (WHERE is_income), 0) inc,\n           COALESCE(-SUM(amount) FILTER (WHERE NOT is_income), 0) exp\n    FROM v_flows\n    WHERE date >= date_trunc('month', now())::date - ($avg_months || ' months')::interval AND date < date_trunc('month', now())::date\n    GROUP BY 1) x) SELECT (cash.v / NULLIF(avg_m.exp + $extra_fixed, 0))::numeric(6,1) AS value FROM cash, avg_m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
