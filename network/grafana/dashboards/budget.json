    {
      "id": 9,
      "type": "table",
      "title": "Budget this month",
      "description": "Envelope state from Actual. Left < 0 = overspent.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "budget-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "budget-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.group_name AS \"Group\", c.name AS \"Category\", bm.budgeted AS \"Budgeted\",\n       -bm.spent AS \"Spent\", bm.balance AS \"Left\"\nFROM budget_months bm JOIN categories c ON c.id = bm.category_id\nWHERE bm.month = date_trunc('month', now())::date AND NOT c.is_income AND NOT c.hidden\nORDER BY c.group_name, c.name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Budgeted"
