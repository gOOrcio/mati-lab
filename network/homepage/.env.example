# Pi-side env file for Homepage. Lives (gitignored) at
# ~/Projects/mati-lab/network/homepage/.env on the dev PC — `make
# deploy-homepage` scp's it to /opt/mati-lab/network/homepage/.env on the Pi
# (network/scripts/common.sh :: copy_env_file) and passes it to compose with
# --env-file. The dev PC copy is the source of truth; editing the Pi copy in
# place gets overwritten on the next deploy.
#
# Each var is consumed by a widget in config/services.yaml or by
# config/proxmox.yaml. An empty var makes that one widget show an API error;
# the rest of the dashboard is unaffected.

# --- Proxmox: services.yaml "Proxmox UI" widget + config/proxmox.yaml guest
#     status for the Proxmox group (VM/LXC CPU + RAM) ---
# Minted on root@192.168.1.184 with:
#   pveum user add homepage@pve --comment "Homepage dashboard (read-only)"
#   pveum acl modify / --users homepage@pve --roles PVEAuditor
#   pveum user token add homepage@pve dashboard --privsep 0
# PVEAuditor is audit-only — the token cannot start, stop or change anything.
# Token id format is "<user>!<tokenid>".
PROXMOX_HOMEPAGE_TOKEN_ID=homepage@pve!dashboard
PROXMOX_HOMEPAGE_TOKEN_SECRET=<from password manager: homelab/proxmox/homepage-readonly>

# --- Homebridge: services.yaml "Homebridge UI" widget ---
# The Homebridge Pi has no SSH (official Homebridge OS image), so this user is
# created through the UI: https://homebridge.mati-lab.online → Settings →
# Manage Users → Add Account → username: homepage, role: Read-only Access.
HOMEBRIDGE_USERNAME=homepage
HOMEBRIDGE_PASSWORD=<from password manager: homelab/homebridge/homepage>
