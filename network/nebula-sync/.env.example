# nebula-sync — replicates Pi-hole config from the Pi (primary) to the NAS
# secondary, so allowlists / denylists / local DNS records added in the UI
# don't drift between the two resolvers.
#
# Copy to .env and fill in. NEVER commit the real .env (root .gitignore
# already covers .env*).

# Admin password of the PRIMARY Pi-hole (this Pi). Same value as
# PIHOLE_ADMIN_PASS in network/pihole/.env.
PIHOLE_PRIMARY_PASSWORD=<from password manager: homelab/pihole/admin>

# Admin password of the REPLICA Pi-hole (NAS, app "pihole2"). Generated at
# deploy time and stored on the NAS at /mnt/fast/databases/pihole2/.env.
PIHOLE_REPLICA_PASSWORD=<from password manager: homelab/pihole2/admin>
