{
  "app_name": "alloy",
  "custom_app": true,
  "values": {
    "ix_context": {}
  },
  "custom_compose_config": {
    "services": {
      "alloy": {
        "image": "grafana/alloy:v1.21.3",
        "restart": "unless-stopped",
        "command": [
          "run",
          "--server.http.listen-addr=0.0.0.0:12345",
          "--storage.path=/var/lib/alloy/data",
          "/etc/alloy/config.alloy"
        ],
        "user": "0:0",
        "volumes": [
          {
            "type": "bind",
            "source": "/mnt/fast/databases/alloy/config.alloy",
            "target": "/etc/alloy/config.alloy",
            "read_only": true
          },
          {
            "type": "bind",
            "source": "/var/run/docker.sock",
            "target": "/var/run/docker.sock",
            "read_only": true
          },
          {
            "type": "bind",
            "source": "/mnt/fast/databases/alloy/data",
            "target": "/var/lib/alloy/data"
          }
        ]
      }
    }
  }
}
